{
  "name": "openwii",
  "version": "0.1.0",
  "private": true,
  "description": "Motion-controlled games for your computer — your phone is the remote.",
  "license": "MIT",
  "author": "Patrick Sun",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pattssun/OpenWii.git"
  },
  "type": "commonjs",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "tv": "open -na 'Google Chrome' --args --user-data-dir=$HOME/.openwii-chrome --no-first-run --no-default-browser-check --autoplay-policy=no-user-gesture-required --new-window https://localhost:8443/",
    "dev": "node --watch server.js",
    "cert": "node scripts/gen-cert.js",
    "test": "node tests/kart-prototype/server.cjs",
    "build:kart-assets": "node games/mario-kart/pipeline/build.mjs",
    "test:kart-browser": "node games/mario-kart/browser-evidence.mjs",
    "test:kart-public": "node games/mario-kart/public-review.mjs",
    "test:unit": "node --test \"core/**/*.test.mjs\" \"games/**/*.test.mjs\" \"scripts/*.test.mjs\" \"tests/kart-prototype/*.test.mjs\"",
    "test:kart-fallback": "node games/mario-kart/public-review.mjs --fallback"
  },
  "dependencies": {
    "express": "^4.21.2",
    "qrcode": "^1.5.4",
    "socket.io": "^4.8.1",
    "three": "^0.185.1"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "playwright": "^1.63.0"
  }
}
